def getMavenDeployDir() {
    if (env.MAVEN_DEPLOY_DIR?.trim()) {
        return env.MAVEN_DEPLOY_DIR.trim()
    }
    if (env.local_maven_url?.trim()) {
        return env.local_maven_url.trim()
    }
    if (env.local_maven?.trim()) {
        return env.local_maven.trim()
    }
    return ''
}

def getReleaseVersion() {
    if (!env.RELEASE_TAG?.trim()) {
        error 'No release tag was found on HEAD; refusing to publish without a tag version.'
    }
    def tagName = env.RELEASE_TAG.trim()
    if (tagName.startsWith('refs/tags/')) {
        tagName = tagName.substring('refs/tags/'.length())
    }
    if (tagName.startsWith('v')) {
        tagName = tagName.substring(1)
    }
    if (!tagName) {
        error "Could not determine release version from RELEASE_TAG='${env.RELEASE_TAG}'."
    }
    return tagName
}

def shellQuote(String value) {
    return "'" + value.replace("'", "'\"'\"'") + "'"
}

def getReleaseGradleArgs() {
    if (env.RELEASE_TAG?.trim()) {
        return "-PRELEASE_VERSION=${shellQuote(getReleaseVersion())}"
    }
    return ''
}

pipeline {
    agent any
    tools {
        jdk "jdk-21"
    }

    environment {
        ORG_GRADLE_PROJECT_BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh "chmod +x gradlew"
            }
        }

        stage('Resolve Release Tag') {
            when {
                branch '1.21.1'
            }
            steps {
                script {
                    sh 'git fetch --tags'
                    env.RELEASE_TAG = sh(
                        script: '''
                            head_commit="$(git rev-parse HEAD)"
                            git for-each-ref --sort=-v:refname --format='%(refname:short)' 'refs/tags/v[0-9]*.[0-9]*.[0-9]*' |
                                while IFS= read -r tag; do
                                    tag_commit="$(git rev-list -n 1 "$tag")"
                                    if [ "$tag_commit" = "$head_commit" ]; then
                                        echo "$tag"
                                        break
                                    fi
                                done
                        ''',
                        returnStdout: true
                    ).trim()
                    if (env.RELEASE_TAG) {
                        echo "Release tag found on HEAD: ${env.RELEASE_TAG}"
                    } else {
                        echo 'No release tag found on HEAD; publishing will be skipped.'
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    sh "./gradlew clean spotlessCheck build :Common:apiJavadoc :Common:checkJarCompatibility validateDocumentationLinks validateFabricEmbedding ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('NeoForge Server GameTests') {
            steps {
                script {
                    sh "./gradlew :NeoForge:runGameTestServer ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Fabric and Forge Server Smoke Tests') {
            steps {
                script {
                    sh "./gradlew --no-configuration-cache :Fabric:runServerSmokeTest :Forge:runServerSmokeTest ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('NeoForge Consumer Embedding') {
            steps {
                script {
                    sh "./gradlew --no-configuration-cache validateNeoForgeEmbedding ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Create Changelogs') {
            steps {
                script {
                    sh "./gradlew :Changelog:makeChangelog ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Archive') {
            steps {
                junit allowEmptyResults: true, testResults: '*/build/test-results/**/*.xml'
                archiveArtifacts allowEmptyArchive: true, artifacts: '*/build/libs/*.jar'
                archiveArtifacts artifacts: 'Changelog/build/changelog.*'
            }
        }

        stage('Publish Maven') {
            when {
                allOf {
                    branch '1.21.1'
                    expression { env.RELEASE_TAG?.trim() }
                }
            }
            steps {
                script {
                    def releaseVersion = getReleaseVersion()
                    def deployDir = getMavenDeployDir()
                    if (!deployDir) {
                        error 'Jared Maven environment is not set; expected MAVEN_DEPLOY_DIR, local_maven_url, or local_maven.'
                    }
                    sh "./gradlew validateReleaseVersion publish -PDEPLOY_DIR=${shellQuote(deployDir)} -PRELEASE_VERSION=${shellQuote(releaseVersion)} --no-daemon"
                }
            }
        }

        stage('Publish CurseForge') {
            when {
                allOf {
                    branch '1.21.1'
                    expression { env.RELEASE_TAG?.trim() }
                }
            }
            environment {
                ORG_GRADLE_PROJECT_curseforgeApikey = credentials('jei-curseforge-key')
            }
            steps {
                script {
                    sh "./gradlew --no-configuration-cache :Fabric:publishCurseforge :Forge:publishCurseforge :NeoForge:publishCurseforge -PpublishDryRun=false ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }

        stage('Publish Modrinth') {
            when {
                allOf {
                    branch '1.21.1'
                    expression { env.RELEASE_TAG?.trim() }
                }
            }
            environment {
                ORG_GRADLE_PROJECT_modrinthToken = credentials('modrinth-auth-token')
            }
            steps {
                script {
                    sh "./gradlew --no-configuration-cache :Fabric:publishModrinth :Forge:publishModrinth :NeoForge:publishModrinth -PpublishDryRun=false ${getReleaseGradleArgs()} --no-daemon"
                }
            }
        }
    }
}
