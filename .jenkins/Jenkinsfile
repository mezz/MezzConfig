library(
    identifier: 'jenkins-release-notifier@v0.2.0',
    retriever: modernSCM([
        $class: 'GitSCMSource',
        remote: 'https://github.com/mezz/jenkins-release-notifier.git'
    ])
)

def getMavenDeployDir() {
    if (env.MAVEN_DEPLOY_DIR?.trim()) {
        return env.MAVEN_DEPLOY_DIR.trim()
    }
    if (env.local_maven_url?.trim()) {
        return env.local_maven_url.trim()
    }
    if (env.local_maven?.trim()) {
        return env.local_maven.trim()
    }
    return ''
}

def getReleaseVersion() {
    if (!env.RELEASE_TAG?.trim()) {
        error 'No release tag was found on HEAD; refusing to publish without a tag version.'
    }
    def tagName = env.RELEASE_TAG.trim()
    if (tagName.startsWith('refs/tags/')) {
        tagName = tagName.substring('refs/tags/'.length())
    }
    if (tagName.startsWith('v')) {
        tagName = tagName.substring(1)
    }
    if (!tagName) {
        error "Could not determine release version from RELEASE_TAG='${env.RELEASE_TAG}'."
    }
    return tagName
}

def shellQuote(String value) {
    return "'" + value.replace("'", "'\"'\"'") + "'"
}

def getReleaseGradleArgs() {
    if (env.RELEASE_TAG?.trim()) {
        return "-PRELEASE_VERSION=${shellQuote(getReleaseVersion())}"
    }
    return ''
}

def findPreviousReleaseCommit() {
    def descriptionPrefix = 'jenkins-release-notifier-source:v1:'
    def previousBuild = currentBuild.previousBuild
    while (previousBuild != null) {
        def description = previousBuild.description ?: ''
        if (description.startsWith(descriptionPrefix)) {
            return description.substring(descriptionPrefix.length())
        }
        previousBuild = previousBuild.previousBuild
    }
    return env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
}

def minecraftTargets() {
    return ['1.19.2', '1.20.1', '1.21.1', '1.21.11', '26.1.2', '26.2', '26.3']
}

def validationTargetBatches() {
    return [
        'Java 21 A': ['1.19.2', '1.21.11'],
        'Java 21 B': ['1.20.1', '1.21.1'],
        'Java 25': ['26.1.2', '26.2', '26.3']
    ]
}

def minecraftLoaders(String target) {
    def manifest = readProperties file: "versions/${target}.properties"
    return manifest.loaders.split(',').toList()
}

def artifactPatterns() {
    return minecraftTargets().collectMany { target ->
        (['Common'] + minecraftLoaders(target)).collect { module ->
            "${module}/build/${target}/libs/*.jar"
        }
    }.join(',')
}

def withMinecraftTarget(String target, Closure action) {
    def loaders = minecraftLoaders(target)
    def jdk = tool(target.startsWith('26.') ? 'jdk-25' : 'jdk-21')
    withEnv(["JAVA_HOME=${jdk}", "PATH+MEZZCONFIG_JAVA=${jdk}/bin"]) {
        action("./gradlew -PminecraftVersion=${shellQuote(target)}", loaders)
    }
}

def forEachMinecraftTarget(Closure action) {
    minecraftTargets().each { target ->
        withMinecraftTarget(target, action)
    }
}

def validateMinecraftTarget(String target) {
    withMinecraftTarget(target) { command, loaders ->
        def validationTasks = [
            'clean',
            'spotlessCheck',
            'build',
            ':Common:apiJavadoc',
            ':Common:checkJarCompatibility',
            'validateDocumentationLinks',
            'validateFabricEmbedding',
            'validatePublishedApiConsumers'
        ]
        if (loaders.contains('NeoForge')) {
            validationTasks.add(':NeoForge:runGameTestServer')
            validationTasks.add('validateNeoForgeEmbedding')
        }
        if (loaders.contains('Forge')) {
            validationTasks.add('validateForgeEmbedding')
        }
        validationTasks.addAll(loaders.findAll { it != 'NeoForge' }.collect { ":${it}:runServerSmokeTest" })
        validationTasks.add(':Changelog:makeChangelog')
        sh "${command} --no-configuration-cache ${validationTasks.join(' ')} ${getReleaseGradleArgs()}"
    }
}

def validateMinecraftTargetsInParallel() {
    def targetBatches = validationTargetBatches()
    def configuredTargets = minecraftTargets()
    def batchedTargets = targetBatches.values().flatten()
    if (batchedTargets.size() != configuredTargets.size() ||
        !batchedTargets.containsAll(configuredTargets) ||
        !configuredTargets.containsAll(batchedTargets)
    ) {
        error 'Validation target batches must contain every configured Minecraft target exactly once.'
    }

    def branches = [:]
    targetBatches.each { batchName, batchTargets ->
        branches[batchName] = {
            batchTargets.each { target ->
                stage("Minecraft ${target}") {
                    validateMinecraftTarget(target)
                }
            }
        }
    }
    parallel branches
}

pipeline {
    agent any
    tools {
        jdk "jdk-21"
    }
    options {
        skipDefaultCheckout(true)
    }

    environment {
        ORG_GRADLE_PROJECT_BUILD_NUMBER = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh "chmod +x gradlew"
            }
        }

        stage('Resolve Release Tag') {
            when {
                branch 'multiversion'
            }
            steps {
                script {
                    sh 'git fetch --tags'
                    env.RELEASE_TAG = sh(
                        script: '''
                            head_commit="$(git rev-parse HEAD)"
                            git for-each-ref --sort=-v:refname --format='%(refname:short)' 'refs/tags/v[0-9]*.[0-9]*.[0-9]*' |
                                while IFS= read -r tag; do
                                    tag_commit="$(git rev-list -n 1 "$tag")"
                                    if [ "$tag_commit" = "$head_commit" ]; then
                                        echo "$tag"
                                        break
                                    fi
                                done
                        ''',
                        returnStdout: true
                    ).trim()
                    if (env.RELEASE_TAG) {
                        echo "Release tag found on HEAD: ${env.RELEASE_TAG}"
                    } else {
                        echo 'No release tag found on HEAD; publishing will be skipped.'
                    }
                }
            }
        }

        stage('Validate Minecraft Targets') {
            steps {
                script {
                    validateMinecraftTargetsInParallel()
                }
            }
        }

        stage('Archive') {
            steps {
                junit allowEmptyResults: true, testResults: '*/build/*/test-results/**/*.xml'
                script {
                    archiveArtifacts allowEmptyArchive: true, artifacts: artifactPatterns()
                }
                archiveArtifacts artifacts: 'Changelog/build/*/changelog.*'
            }
        }

        stage('Publish Maven') {
            when {
                allOf {
                    branch 'multiversion'
                    expression { env.RELEASE_TAG?.trim() }
                }
            }
            steps {
                script {
                    def releaseVersion = getReleaseVersion()
                    def deployDir = getMavenDeployDir()
                    if (!deployDir) {
                        error 'Jared Maven environment is not set; expected MAVEN_DEPLOY_DIR, local_maven_url, or local_maven.'
                    }
                    forEachMinecraftTarget { command, loaders ->
                        sh "${command} publishMavenRelease -PDEPLOY_DIR=${shellQuote(deployDir)} -PRELEASE_VERSION=${shellQuote(releaseVersion)}"
                    }
                }
            }
        }

        stage('Publish CurseForge') {
            when {
                allOf {
                    branch 'multiversion'
                    expression { env.RELEASE_TAG?.trim() }
                }
            }
            environment {
                ORG_GRADLE_PROJECT_curseforgeApikey = credentials('jei-curseforge-key')
            }
            steps {
                script {
                    forEachMinecraftTarget { command, loaders ->
                        def publishTasks = loaders.collect { ":${it}:publishCurseforge" }.join(' ')
                        sh "${command} --no-configuration-cache ${publishTasks} -PpublishDryRun=false ${getReleaseGradleArgs()}"
                    }
                }
            }
        }

        stage('Publish Modrinth') {
            when {
                allOf {
                    branch 'multiversion'
                    expression { env.RELEASE_TAG?.trim() }
                }
            }
            environment {
                ORG_GRADLE_PROJECT_modrinthToken = credentials('modrinth-auth-token')
            }
            steps {
                script {
                    forEachMinecraftTarget { command, loaders ->
                        def publishTasks = loaders.collect { ":${it}:publishModrinth" }.join(' ')
                        sh "${command} --no-configuration-cache ${publishTasks} -PpublishDryRun=false ${getReleaseGradleArgs()}"
                    }
                }
            }
        }

        stage('Notify Released Issues') {
            when {
                allOf {
                    branch 'multiversion'
                    expression { env.RELEASE_TAG?.trim() }
                    expression { currentBuild.currentResult == 'SUCCESS' }
                }
            }
            steps {
                script {
                    def baseCommit = findPreviousReleaseCommit()
                    if (baseCommit) {
                        def releaseMetadata = discordNotifier.getGradleReleaseMetadata(
                            version: getReleaseVersion()
                        )
                        releaseNotifier(
                            workerJob: '/mezz/release-notifier-worker',
                            repository: 'mezz/MezzConfig',
                            channel: 'multiversion',
                            projectName: releaseMetadata.projectName,
                            version: releaseMetadata.version,
                            baseCommit: baseCommit,
                            headCommit: env.GIT_COMMIT,
                            releaseLinks: releaseMetadata.releaseLinks,
                            minecraftVersions: minecraftTargets(),
                            modLoaders: releaseMetadata.modLoaders
                        )
                    } else {
                        echo 'No previous release commit found; recording this release as the notification baseline.'
                    }
                    currentBuild.description = "jenkins-release-notifier-source:v1:${env.GIT_COMMIT}"
                }
            }
        }
    }
    post {
        always {
            script {
                def notification = [workerJob: '/mezz/release-notifier-worker']
                if (env.RELEASE_TAG?.trim()) {
                    notification.version = getReleaseVersion()
                } else {
                    // Successful branch builds are not releases, so suppress fallback download links.
                    notification.releaseLinks = []
                }
                discordNotifier(notification)
            }
        }
    }
}
