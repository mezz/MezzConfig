{
  "schemaVersion": 1,
  "id": "${fabricTestModId}",
  "version": "${version}",

  "name": "MezzConfig Fabric Test",
  "description": "In-game test config registrations for MezzConfig on Fabric.",
  "authors": [
    "${modAuthor}"
  ],

  "license": "The MIT License (MIT)",

  "environment": "*",
  "entrypoints": {
    "mezz_config_plugin": [
      "net.mezzdev.config.test.fabric.FabricTestConfigPlugin"
    ]
  },

  "depends": {
    "fabricloader": "${fabricLoaderVersionRange}",
    "${configModId}": "*",
    "minecraft": "${minecraftVersion}",
    "java": ">=${modJavaVersion}"
  }
}
