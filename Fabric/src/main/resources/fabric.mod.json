{
  "schemaVersion": 1,
  "id": "${configModId}",
  "version": "${version}",

  "name": "MezzConfig",
  "description": "Lightweight client and server-authoritative config support for Minecraft mods.",
  "authors": [
    "${modAuthor}"
  ],
  "contact": {
    "sources": "${githubUrl}"
  },

  "license": "The MIT License (MIT)",

  "environment": "*",
  "entrypoints": {
	"main": [
	  "net.mezzdev.config.fabric.ConfigFabric"
	],
    "client": [
      "net.mezzdev.config.fabric.ConfigFabricClient"
    ]
  },

  "depends": {
    "fabricloader": "${fabricLoaderVersionRange}",
	"fabric-api": "${fabricApiVersionRange}",
    "minecraft": "${minecraftVersion}",
    "java": ">=${modJavaVersion}"
  }
}
